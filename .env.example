# ==============================================================================
# SendResQPls Backend - Environment Variables Configuration
# ==============================================================================

# Server Environment & Port
PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. Database (REQUIRED)
# ------------------------------------------------------------------------------
# PostgreSQL connection string for Prisma ORM
DATABASE_URL=postgresql://user:password@hostname:5432/database?sslmode=require

# ------------------------------------------------------------------------------
# 2. Authentication & Security (REQUIRED)
# ------------------------------------------------------------------------------
# Secret key for signing and verifying JWT session tokens (at least 32 characters)
JWT_SECRET=your_super_secret_jwt_signing_key_here

# ------------------------------------------------------------------------------
# 3. Client Frontend URLs (REQUIRED for CORS & Password Reset Links)
# ------------------------------------------------------------------------------
# Admin portal origin (used for CORS allowlist)
FRONTEND_URL=https://sendresqpls-admin.vercel.app

# Mobile app origin (used for CORS allowlist and password reset email links)
MOBILE_FRONTEND_URL=https://sendresqpls-mobile.vercel.app

# ------------------------------------------------------------------------------
# 4. Email Service - Brevo / Sendinblue (REQUIRED for OTP & Notifications)
# ------------------------------------------------------------------------------
# If missing: signup OTP verification codes and password reset emails will fail!
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
SYSTEM_EMAIL=bertingmagiting16@gmail.com

# ------------------------------------------------------------------------------
# 5. Media Uploads - Cloudinary (REQUIRED for Incident Photos)
# ------------------------------------------------------------------------------
# If missing: image uploads when reporting emergencies will fail!
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 6. Artificial Intelligence - Google Gemini (RECOMMENDED)
# ------------------------------------------------------------------------------
# Powers emergency photo classification, severity analysis, and department routing.
# If missing: reports fall back to "Emergency (Pending Review)" for manual triage.
GEMINI_API_KEY=your_google_gemini_api_key_here

# ------------------------------------------------------------------------------
# 7. Reverse Geocoding - Google Maps (OPTIONAL)
# ------------------------------------------------------------------------------
# Used for converting coordinates to street/barangay names.
# If missing: automatically falls back to offline local Balayan Haversine polygon mapping.
GOOGLE_MAPS_API_KEY=your_google_maps_geocoding_api_key_here

# ------------------------------------------------------------------------------
# 8. Asynchronous Processing - Upstash Redis / BullMQ (OPTIONAL)
# ------------------------------------------------------------------------------
# Connection URL for serverless Redis (rediss://default:token@host:port)
# If missing: automatically falls back to in-process direct asynchronous execution.
UPSTASH_REDIS_URL=rediss://default:your_redis_token@your-redis-host.upstash.io:6379

# ------------------------------------------------------------------------------
# 9. Push Notifications - Firebase Admin SDK (RECOMMENDED for Mobile Push)
# ------------------------------------------------------------------------------
# Full JSON string of Firebase service account key from Firebase Console:
# Project Settings -> Service accounts -> Generate new private key
# If missing: native push notifications to Android devices will be skipped.
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}
